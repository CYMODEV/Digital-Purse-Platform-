const DepositedNote = ({ note, type, isSettling }) => {
    let scale = "scale(0.65)";
    let opacity = 1;
    let zIndexLayer = Math.floor(note.id % 100);

    if (type === 'hat') {
        scale = "scale(0.55)";
    } else if (type === 'jar') {
        opacity = 0.85;
    } else if (type === 'table') {
        scale = "scale(0.75)";
        zIndexLayer += 50; 
    }

    const floatDur = 3 + (note.id % 3) + "s"; 
    const floatDel = "-" + (note.id % 5) + "s"; 

    // Beam settling logic
    const settlingStyle = isSettling ? {
        transform: `translate(${note.x}px, calc(-800px + ${note.y}px)) rotate(${note.rotation}deg) scale(0.2)`,
        opacity: 0,
        transition: 'all 0.4s cubic-bezier(0.1, -0.6, 0.2, 1)'
    } : {
        transform: `translate(${note.x}px, ${note.y}px) rotate(${note.rotation}deg) ${scale}`,
        opacity: opacity,
        transition: 'all 0.5s ease-out'
    };

    return (
        <div className="absolute" style={{ ...settlingStyle, zIndex: zIndexLayer }}>
             <div className="floating-3d-note" style={{ '--float-dur': floatDur, '--float-del': floatDel }}>
                 <BearerNote dragging={false} denomination={note.denomination} />
             </div>
        </div>
    );
};

