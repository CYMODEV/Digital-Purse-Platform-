                            </div>
                            <div className="bg-[#00050D] rounded-xl p-1 mb-4 flex border border-white/10">
                                <div className="flex-1 px-4 py-2 font-mono text-sm text-white/80 flex items-center justify-center tracking-widest">RINGPAY-8F9A</div>
                                <button onClick={copyReferralCode} className="bg-white/10 hover:bg-white/20 p-2 rounded-lg text-white/70 transition-colors"><Copy size={16}/></button>
                            </div>
                            <div className="flex justify-between items-center p-3 rounded-xl bg-white/5 border border-white/5 mb-4">
                                <span className="text-sm text-white/70">Total Successful Referrals</span><span className="font-mono font-bold text-yellow-300">{referralsCount} Users</span>
                            </div>
                            <button onClick={handleSimulateReferral} className="w-full py-2.5 rounded-xl bg-yellow-400/20 hover:bg-yellow-400/30 border border-yellow-400/30 text-yellow-200 font-bold text-sm transition-all flex items-center justify-center gap-2">
                                <Users size={16}/> Simulate New Referral (+500 RINGPAY)
                            </button>
                        </div>
                    </div>
                </div>
            )}

            {activeModal === 'history' && (
                <div className="fixed inset-0 z-[150] flex items-center justify-center p-4 bg-black/60 backdrop-blur-md" onClick={() => setActiveModal(null)}>
                    <div className="glass-modal w-full max-w-md h-[70vh] rounded-3xl p-6 flex flex-col relative" onClick={e => e.stopPropagation()}>
                        <div className="absolute top-4 right-4 flex gap-2">
                            <button onClick={exportLedgerCSV} className="text-white/50 hover:text-yellow-300 p-2 transition-colors" title="Export CSV"><Download size={20}/></button>
                            <button onClick={() => setActiveModal(null)} className="text-white/50 hover:text-white p-2 transition-colors"><X size={24}/></button>
                        </div>
                        <h2 className="text-xl font-bold text-yellow-300 mb-6 flex items-center gap-2"><History size={20}/> Audit Ledger</h2>
                        <div className="flex-1 overflow-y-auto scrollbar-hide flex flex-col gap-3">
                            {transactions.length === 0 ? (
                                <div className="text-white/40 text-center mt-10">No transactions yet.</div>
                            ) : (
                                transactions.map(tx => (
                                    <div key={tx.id} className="flex justify-between items-center p-3 rounded-xl bg-white/5 border border-white/5">
                                        <div>
                                            <div className="text-sm font-bold text-white/90 capitalize">{tx.type.includes('transfer') || tx.type.includes('split') ? 'Beamed Payload' : tx.type.replace('-', ' ')}</div>
                                            <div className="text-xs text-white/40">{tx.date}</div>
                                        </div>
                                        <div className={`font-mono font-bold flex flex-col items-end ${tx.type.includes('transfer') || tx.type.includes('split') ? 'text-yellow-300' : tx.type.includes('reward') || tx.type === 'topup' || tx.type.includes('referral') ? 'text-yellow-200' : 'text-slate-300'}`}>
                                            <div>{tx.type === 'deposit' || tx.type.includes('redemption') ? '-' : '+'}{tx.amount}</div>
                                            {(tx.type.includes('transfer') || tx.type.includes('split')) && <div className="text-[9px] text-yellow-400/50 font-sans tracking-wide uppercase max-w-[120px] truncate">{tx.type.replace('transfer to ', '').replace('split to ', '')}</div>}
                                            {tx.type === 'reward points' && <div className="text-[9px] text-yellow-300/50 font-sans tracking-wide uppercase">PTS</div>}
                                        </div>
                                    </div>
                                ))
                            )}
                        </div>
                    </div>
                </div>
            )}

            {activeModal === 'settings' && (
                <div className="fixed inset-0 z-[150] flex items-center justify-center p-4 bg-black/60 backdrop-blur-md" onClick={() => setActiveModal(null)}>
                    <div className="glass-modal w-full max-w-md rounded-3xl p-6 flex flex-col relative gap-6" onClick={e => e.stopPropagation()}>
                        <button onClick={() => setActiveModal(null)} className="absolute top-4 right-4 text-white/50 hover:text-white p-2"><X size={24}/></button>
                        <h2 className="text-xl font-bold text-slate-300 flex items-center gap-2"><Settings size={20}/> Settings</h2>
                        
                        <div className="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/5">
                            <div className="flex items-center gap-3">
                                <Cast className="text-yellow-300" size={24}/>
                                <div><div className="text-sm font-bold text-white/90">Total P2P Beamed</div><div className="text-xs text-white/50">Across all targets</div></div>
                            </div>
                            <div className="text-right">
                                <div className="text-xl font-mono text-yellow-300 font-bold">{Object.values(agentBalances).reduce((a, b) => a + b, 0).toFixed(2).replace(/\.00$/, '')}</div>
                                <div className="text-[10px] text-yellow-400/50 font-mono">≈ ${Object.values(agentBalances).reduce((a, b) => a + b, 0).toFixed(2)} USD</div>
                            </div>
                        </div>

                        <div className="grid grid-cols-1 gap-3 mt-2">
                            <button onClick={backupWallet} className="flex items-center gap-3 p-4 rounded-xl bg-yellow-300/10 hover:bg-yellow-300/20 text-yellow-200 border border-yellow-300/20 transition-colors text-left">
                                <Key size={20}/>
                                <div><div className="font-bold">Backup Wallet Keys</div><div className="text-xs opacity-70">Export encrypted local state (JSON)</div></div>
                            </button>

                            <button onClick={handleTopUp} className="flex items-center gap-3 p-4 rounded-xl bg-yellow-400/10 hover:bg-yellow-400/20 text-yellow-300 border border-yellow-400/20 transition-colors text-left">
                                <PlusCircle size={20}/>
                                <div><div className="font-bold">Top-Up ePurse</div><div className="text-xs opacity-70">Add 1,000 RINGPAY for testing</div></div>
                            </button>
                            
                            <button onClick={() => setIsMuted(!isMuted)} className="flex items-center gap-3 p-4 rounded-xl bg-white/5 hover:bg-white/10 text-white/90 border border-white/5 transition-colors text-left">
                                {isMuted ? <VolumeX size={20} className="text-slate-400"/> : <Volume2 size={20} className="text-yellow-300"/>}
                                <div><div className="font-bold">Sound & Haptics</div><div className="text-xs opacity-70">{isMuted ? 'Currently Muted' : 'Currently Active'}</div></div>
                            </button>

                            <button onClick={clearData} className="flex items-center gap-3 p-4 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 border border-red-500/20 transition-colors text-left mt-4">
                                <Trash2 size={20}/>
                                <div><div className="font-bold">Reset Application</div><div className="text-xs opacity-70">Clear ledger and balances</div></div>
                            </button>
                        </div>
                    </div>
                </div>
            )}
        </div>
    );
}
