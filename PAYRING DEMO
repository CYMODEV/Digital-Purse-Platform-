    const [agentBalances, setAgentBalances] = useState(() => {
        const saved = localStorage.getItem('ringpay_agent_balances');
        if (saved) return JSON.parse(saved);
        return { "Nearby Partner": parseInt(localStorage.getItem('ringpay_agent')) || 0 };
    });
    const [activePartners, setActivePartners] = useState(() => {
        const saved = localStorage.getItem('ringpay_active_partners');
        if (saved) return JSON.parse(saved);
        return ["Nearby Partner"];
    });
    
    const [transactions, setTransactions] = useState(() => JSON.parse(localStorage.getItem('ringpay_txs')) || []);
    const [isMuted, setIsMuted] = useState(() => localStorage.getItem('ringpay_muted') === 'true');
    const [rewardPoints, setRewardPoints] = useState(() => parseInt(localStorage.getItem('ringpay_rewards')) || 0);
    const [referralsCount, setReferralsCount] = useState(() => parseInt(localStorage.getItem('ringpay_referrals')) || 0);
    const [isOnline, setIsOnline] = useState(typeof navigator !== 'undefined' ? navigator.onLine : true);
    const [userProfile, setUserProfile] = useState(() => JSON.parse(localStorage.getItem('ringpay_user')) || { name: 'Anonymous User', handle: '@anon_user', type: 'Individual' });
    const [customPartners, setCustomPartners] = useState(() => JSON.parse(localStorage.getItem('ringpay_custom_partners')) || []);
    
    // API Dev State
    const [instruments, setInstruments] = useState([
        { id: 'inst-1', symbol: 'R-USD', name: 'RingPay Digital Dollar', type: 'Fiat Stablecoin', status: 'Active' },
        { id: 'inst-2', symbol: 'R-EUR', name: 'RingPay Euro Bearer', type: 'Fiat Stablecoin', status: 'Active' },
        { id: 'inst-3', symbol: 'T-YLD', name: 'US Treasury Bearer Note', type: 'Yield Instrument', status: 'Sandbox' },
        { id: 'inst-4', symbol: 'XAU-M', name: 'Minted Physical Gold', type: 'Commodity Peg', status: 'Sandbox' }
    ]);
    const [apiKeys, setApiKeys] = useState([
        { id: 'key-1', name: 'Production Node Alpha', prefix: 'rp_live_8f9a...', active: true },
        { id: 'key-2', name: 'Testnet Sandbox', prefix: 'rp_test_3b2c...', active: true }
    ]);
    const [isRegisteringInstrument, setIsRegisteringInstrument] = useState(false);
    const [newInstrumentForm, setNewInstrumentForm] = useState({ symbol: '', name: '', type: 'Fiat Stablecoin' });

    // UI & Session State
    const [isEditingProfile, setIsEditingProfile] = useState(false);
    const [isRegisteringPartner, setIsRegisteringPartner] = useState(false);
    const [newPartnerForm, setNewPartnerForm] = useState({ name: '', type: 'Charity Foundation' });
    const [isEventMode, setIsEventMode] = useState(false);
    const [vesselBalance, setVesselBalance] = useState(0);
    const [vesselType, setVesselType] = useState('table');
    const [depositedNotes, setDepositedNotes] = useState([]);
    const [isSettling, setIsSettling] = useState(false);
    const [activeModal, setActiveModal] = useState(null); 
    const [receiptData, setReceiptData] = useState(null); 
    const [isRipping, setIsRipping] = useState(false); 
    const [showQRScanner, setShowQRScanner] = useState(false);
    const [receiptKudos, setReceiptKudos] = useState(false); 
    const [authPrompt, setAuthPrompt] = useState({ visible: false, message: '', action: null, status: 'idle' });
    
    const [currentDenomination, setCurrentDenomination] = useState(100);
    const availableDenominations = [1, 5, 10, 50, 100];
    const [appCategory, setAppCategory] = useState('All'); 
    
    // Swipe Settle state
    const [swipeOffset, setSwipeOffset] = useState(0);
    const swipeRef = useRef({ startY: null, isSwiping: false, currentOffset: 0 });
    
    // Dragging state
    const [dragging, setDragging] = useState(false);
    const [dragPos, setDragPos] = useState({ x: 0, y: 0 });
    const [isOverTarget, setIsOverTarget] = useState(false);
    const [toast, setToast] = useState(null);

    const vesselRef = useRef(null);
    const dragCache = useRef({ rect: null });

    const showToast = (msg) => {
        setToast(msg);
        setTimeout(() => setToast(null), 3000);
    };

    const logTransaction = (type, amount) => {
        setTransactions(prev => [{
            id: Date.now() + Math.random(),
            type,
            amount,
            date: new Date().toLocaleString()
        }, ...prev].slice(0, 50));
    };

    useEffect(() => {
        const handleOnline = () => { setIsOnline(true); showToast("Connection restored. P2P Ready."); };
        const handleOffline = () => { setIsOnline(false); showToast("Offline mode. Local accumulation active."); };
        window.addEventListener('online', handleOnline);
        window.addEventListener('offline', handleOffline);
        return () => {
            window.removeEventListener('online', handleOnline);
            window.removeEventListener('offline', handleOffline);
        };
    }, []);

    useEffect(() => {
        let scanTimer;
        if (showQRScanner && !isEventMode) {
            scanTimer = setTimeout(() => {
                vibrate([50, 100, 50]);
                playCoinDrop(); 
                setPurseBalance(prev => prev + 250);
                logTransaction('p2p transfer received', 250);
                showToast("Received 250 RINGPAY via P2P Transfer!");
                setShowQRScanner(false);
            }, 4000);
        }
        return () => clearTimeout(scanTimer);
    }, [showQRScanner, isEventMode]);

    useEffect(() => {
        let interval;
        if (isEventMode && isOnline) {
            interval = setInterval(() => {
                const denoms = [1, 5, 10, 50, 100];
                const randomDenom = denoms[Math.floor(Math.random() * denoms.length)];
                vibrate([50, 30, 50]); 
                playThud();
                if (randomDenom === 1 || randomDenom === 5) setTimeout(playCoinDrop, 50);
                else setTimeout(playRustle, 50);
                setVesselBalance(prev => prev + randomDenom);
                logTransaction('event mode contribution', randomDenom);
                setDepositedNotes(prev => [...prev, {
                    id: Date.now() + Math.random(),
                    rotation: Math.random() * 360,
                    x: (Math.random() - 0.5) * 80,
                    y: (Math.random() - 0.5) * 80,
                    denomination: randomDenom
                }]);
            }, 7000);
        }
        return () => clearInterval(interval);
    }, [isEventMode, isOnline]);

    useEffect(() => {
        localStorage.setItem('ringpay_purse', purseBalance);
        localStorage.setItem('ringpay_agent_balances', JSON.stringify(agentBalances));
        localStorage.setItem('ringpay_active_partners', JSON.stringify(activePartners));
        localStorage.setItem('ringpay_txs', JSON.stringify(transactions));
        localStorage.setItem('ringpay_muted', isMuted);
        localStorage.setItem('ringpay_rewards', rewardPoints);
        localStorage.setItem('ringpay_referrals', referralsCount);
        localStorage.setItem('ringpay_user', JSON.stringify(userProfile));
        localStorage.setItem('ringpay_custom_partners', JSON.stringify(customPartners));
        window.isAppMuted = isMuted;
    }, [purseBalance, agentBalances, activePartners, transactions, isMuted, rewardPoints, referralsCount, userProfile, customPartners]);

    useEffect(() => {
        const styleSheet = document.createElement("style");
        styleSheet.innerText = styles;
        document.head.appendChild(styleSheet);
        return () => styleSheet.remove();
    }, []);

    const cycleDenomination = (direction) => {
        vibrate(20);
        const currentIndex = availableDenominations.indexOf(currentDenomination);
        let nextIndex = currentIndex + direction;
        if (nextIndex >= availableDenominations.length) nextIndex = 0;
        if (nextIndex < 0) nextIndex = availableDenominations.length - 1;
        setCurrentDenomination(availableDenominations[nextIndex]);
    };

    const depositNote = () => {
        if (purseBalance < currentDenomination) {
            showToast("Insufficient RINGPAY balance in ePurse!");
            return;
        }
        vibrate([50, 30, 50]); 
        playThud();
        if (currentDenomination === 1 || currentDenomination === 5) setTimeout(playCoinDrop, 50);
        else setTimeout(playRustle, 50);

        setPurseBalance(prev => prev - currentDenomination);
        setVesselBalance(prev => prev + currentDenomination);
        logTransaction('deposit', currentDenomination);

        setDepositedNotes(prev => [...prev, {
            id: Date.now(),
            rotation: Math.random() * 360,
            x: (Math.random() - 0.5) * 80,
            y: (Math.random() - 0.5) * 80,
            denomination: currentDenomination
        }]);
    };

    const requestAuth = (message, actionCallback) => {
        setAuthPrompt({ visible: true, message, action: actionCallback, status: 'idle' });
    };

    const processAuth = () => {
        vibrate(20);
        setAuthPrompt(prev => ({ ...prev, status: 'scanning' }));
        setTimeout(() => {
            vibrate([30, 50]);
            setAuthPrompt(prev => ({ ...prev, status: 'success' }));
            setTimeout(() => {
                authPrompt.action();
                setAuthPrompt({ visible: false, message: '', action: null, status: 'idle' });
            }, 500);
        }, 1500);
    };

    const executeSettle = () => {
        if (vesselBalance === 0 || activePartners.length === 0) return;
        vibrate([50, 80, 50, 100]);
        playBeamSound();
        setIsSettling(true);
        setReceiptKudos(false); 
        
        setTimeout(() => {
            const splitAmount = Number((vesselBalance / activePartners.length).toFixed(2));
            setAgentBalances(prev => {
                const next = { ...prev };
                activePartners.forEach(partner => { next[partner] = (next[partner] || 0) + splitAmount; });
                return next;
            });
            activePartners.forEach(partner => {
                logTransaction(activePartners.length > 1 ? `split to ${partner}` : `transfer to ${partner}`, splitAmount);
            });
            
            const pointsEarned = Math.floor(vesselBalance * 0.1);
            if (pointsEarned > 0) {
                setRewardPoints(prev => prev + pointsEarned);
                logTransaction('reward points', pointsEarned);
            }
            
            setReceiptData({
                id: `TX-${Math.random().toString(36).substr(2, 9).toUpperCase()}`,
                amount: vesselBalance,
                splitAmount: splitAmount,
                partners: activePartners,
                date: new Date().toLocaleString()
            });

            setTimeout(playPrintSound, 200); 
            setVesselBalance(0);
            setDepositedNotes([]);
            setIsSettling(false);
        }, 800);
    };

    const handleSettle = () => executeSettle();
    
    const handleRefund = () => {
        if (vesselBalance === 0) return;
        vibrate([20, 30]);
        playRustle();
        setPurseBalance(prev => prev + vesselBalance);
        setVesselBalance(0);
        setDepositedNotes([]);
        showToast("Returned notes to ePurse.");
    };

    const handleTearReceipt = () => {
        vibrate([40, 20]);
        playTearSound();
        setIsRipping(true);
        setTimeout(() => { setReceiptData(null); setIsRipping(false); }, 600);
    };

    const handleTopUp = () => {
        setPurseBalance(prev => prev + 1000);
        logTransaction('topup', 1000);
        showToast("ePurse topped up with 1000 RINGPAY.");
    };

    const exitEventMode = () => {
        requestAuth("Authenticate to exit Receive Terminal Mode", () => {
            setIsEventMode(false);
            showToast("Exited Receive Terminal Mode.");
        });
    };

    const exportLedgerCSV = () => {
        if(transactions.length === 0) return showToast("Ledger is empty. No data to export.");
        vibrate(20);
        const headers = "Transaction_ID,Date,Type,Amount_RINGPAY\n";
        const csv = headers + transactions.map(t => `${t.id},"${t.date}",${t.type},${t.amount}`).join("\n");
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ringpay-ledger-export-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast("Ledger exported as CSV.");
    };

    const executeBackup = () => {
        vibrate([30, 50]);
        const backupData = JSON.stringify({ version: "1.0.0", exportDate: new Date().toISOString(), balances: { purse: purseBalance, agent: agentBalances }, rewards: rewardPoints, referrals: referralsCount }, null, 2);
        const blob = new Blob([backupData], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'ringpay-wallet-backup.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast("Encrypted wallet backup downloaded.");
    };

    const backupWallet = () => requestAuth("Authenticate to decrypt wallet backup", executeBackup);

    const handleSimulateReferral = () => {
        vibrate([30, 50, 30]);
        setReferralsCount(prev => prev + 1);
        setPurseBalance(prev => prev + 500);
        logTransaction('referral bonus', 500);
        showToast("Referral claimed! +500 RINGPAY Bonus added to ePurse.");
    };

    const handleRedeemPoints = () => {
        if (rewardPoints >= 100) {
            vibrate([50, 50, 100]);
            setRewardPoints(prev => prev - 100);
            setPurseBalance(prev => prev + 100);
            logTransaction('points redemption', 100);
            showToast("Redeemed 100 Points for 100 RINGPAY!");
        } else {
            showToast("You need at least 100 points to redeem.");
        }
    };

    const copyReferralCode = () => {
        navigator.clipboard.writeText("RINGPAY-8F9A");
        vibrate(20);
        showToast("Referral code copied to clipboard!");
    };

    const handleSaveProfile = () => {
        setIsEditingProfile(false);
        vibrate(20);
        showToast("Profile registered successfully!");
    };

    const handleRegisterPartner = () => {
        if (!newPartnerForm.name.trim()) return showToast("Partner organization name is required.");
        const ALL_PARTNERS = [...PARTNER_DIRECTORY, ...customPartners];
        if (ALL_PARTNERS.some(p => p.name.toLowerCase() === newPartnerForm.name.toLowerCase())) {
            return showToast("A partner with this name already exists.");
        }
        const newEntry = { id: `custom-${Date.now()}`, name: newPartnerForm.name, type: newPartnerForm.type, verified: false, rating: "0" };
        vibrate([30, 50]);
        setCustomPartners(prev => [...prev, newEntry]);
        setActivePartners(prev => [...prev, newEntry.name]); 
        setIsRegisteringPartner(false);
        setNewPartnerForm({ name: '', type: 'Charity Foundation' });
        showToast(`${newEntry.name} registered and activated!`);
    };

    const handleRegisterInstrument = () => {
        if (!newInstrumentForm.symbol.trim() || !newInstrumentForm.name.trim()) return showToast("Instrument symbol and name are required.");
        const newEntry = { id: `inst-${Date.now()}`, symbol: newInstrumentForm.symbol.toUpperCase(), name: newInstrumentForm.name, type: newInstrumentForm.type, status: 'Sandbox' };
        vibrate([30, 50]);
        setInstruments(prev => [...prev, newEntry]);
        setIsRegisteringInstrument(false);
        setNewInstrumentForm({ symbol: '', name: '', type: 'Fiat Stablecoin' });
        showToast(`Instrument ${newEntry.symbol} minted to Sandbox!`);
    };

    const handleGenerateApiKey = () => {
        vibrate(20);
        const newKey = { id: `key-${Date.now()}`, name: `Webhook Interface ${apiKeys.length + 1}`, prefix: `rp_live_${Math.random().toString(36).substr(2, 4)}...`, active: true };
        setApiKeys(prev => [...prev, newKey]);
        showToast("New Production API Key generated.");
    };

    // --- Swipe Logic Handlers (Phone-to-Phone Throw) ---
    const handleVesselPointerDown = (e) => {
        if (vesselBalance === 0 || isSettling || !isOnline) return;
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        
        swipeRef.current.startY = e.clientY;
        swipeRef.current.isSwiping = true;
        swipeRef.current.currentOffset = 0;
        e.currentTarget.setPointerCapture(e.pointerId);
    };

    const handleVesselPointerMove = (e) => {
        if (!swipeRef.current.isSwiping) return;
        const deltaY = e.clientY - swipeRef.current.startY;
        
        // Cap the physical drag between -180px (up) and 0px (base)
        const offset = Math.min(0, Math.max(deltaY, -180));
        setSwipeOffset(offset);
        swipeRef.current.currentOffset = offset;
    };

    const handleVesselPointerUp = (e) => {
        if (!swipeRef.current.isSwiping) return;
        swipeRef.current.isSwiping = false;
        e.currentTarget.releasePointerCapture(e.pointerId);
        
        // If swiped high enough (thrown), trigger settlement toss
        if (swipeRef.current.currentOffset < -80 && isOnline) {
            handleSettle();
        }
        setSwipeOffset(0); 
        swipeRef.current.currentOffset = 0;
    };

    const clearData = () => {
        if(window.confirm("Reset all local data?")) {
            setPurseBalance(2500);
            setAgentBalances({ "Nearby Partner": 0 });
            setActivePartners(["Nearby Partner"]);
            setTransactions([]);
            setRewardPoints(0);
            setReferralsCount(0);
            setUserProfile({ name: 'Anonymous User', handle: '@anon_user', type: 'Individual' });
            setCustomPartners([]);
            setVesselBalance(0);
            setDepositedNotes([]);
            showToast("Data reset to defaults.");
            setActiveModal(null);
        }
    };

    const togglePartner = (partnerName) => {
        setActivePartners(prev => {
            if (prev.includes(partnerName)) {
                if (prev.length === 1) return prev; 
                return prev.filter(p => p !== partnerName);
            }
            return [...prev, partnerName];
        });
    };

    const PARTNER_DIRECTORY = [
        { id: '1', name: "Nearby Partner", type: "P2P Device", verified: true, rating: "4.9k" },
        { id: '2', name: "Downtown Buskers Union", type: "Street Performance", verified: true, rating: "1.2k" },
        { id: '3', name: "Global Red Cross", type: "Charity Foundation", verified: true, rating: "18k" },
        { id: '5', name: "Local Coffee Co.", type: "Retail / Tipping", verified: true, rating: "850" }
    ];
    const ALL_PARTNERS = [...PARTNER_DIRECTORY, ...customPartners];

    const APP_DIRECTORY = [
        { id: 'app1', name: "RingPay Plate", desc: "Skeuomorphic drop-zone for offline tips.", active: true, icon: HandHeart, category: "Creator" },
        { id: 'app2', name: "RingPay POS", desc: "Point-of-sale terminal for retail.", active: true, icon: LayoutGrid, category: "Retail" },
        { id: 'app3', name: "RingPay Escrow", desc: "Smart contract multi-sig hold.", active: true, icon: ShieldCheck, category: "Enterprise" },
        { id: 'app4', name: "RingPay Beam", desc: "P2P Phone-to-Phone NFC transfers.", active: true, icon: Cast, category: "Creator" }
    ];
    const APP_CATEGORIES = ['All', 'Creator', 'Retail', 'Enterprise', 'Charity'];
    const filteredApps = appCategory === 'All' ? APP_DIRECTORY : APP_DIRECTORY.filter(a => a.category === appCategory);

    const handlePointerDown = (e) => {
        if (e.target.closest('.cycle-btn') || isEventMode) return;
        if (purseBalance < currentDenomination) return showToast(`Not enough balance for a ${currentDenomination} note.`);
        e.preventDefault();
        vibrate(30); 
        setDragging(true);
        setDragPos({ x: e.clientX, y: e.clientY });
        if (vesselRef.current) dragCache.current.rect = vesselRef.current.getBoundingClientRect();
    };

    useEffect(() => {
        const handlePointerMove = (e) => {
            if (!dragging) return;
            setDragPos({ x: e.clientX, y: e.clientY });
            if (dragCache.current.rect) {
                const rect = dragCache.current.rect;
                const vesselX = rect.left + rect.width / 2;
                const vesselY = rect.top + rect.height / 2;
                const distance = Math.hypot(e.clientX - vesselX, e.clientY - vesselY);
                const hitRadius = (rect.width / 2) * 1.2; 
                if (distance < hitRadius && !isOverTarget) { setIsOverTarget(true); vibrate(15); } 
                else if (distance >= hitRadius && isOverTarget) { setIsOverTarget(false); }
            }
        };
        const handlePointerUp = (e) => {
            if (!dragging) return;
            setDragging(false);
            if (isOverTarget) depositNote(); else showToast("Note returned to pocket.");
            setIsOverTarget(false);
        };
        if (dragging) {
            window.addEventListener('pointermove', handlePointerMove);
            window.addEventListener('pointerup', handlePointerUp);
        }
        return () => {
            window.removeEventListener('pointermove', handlePointerMove);
            window.removeEventListener('pointerup', handlePointerUp);
        };
    }, [dragging, isOverTarget, purseBalance, currentDenomination]);

    if (isEventMode) {
        return (
            <div className="min-h-screen flex flex-col bg-[#010613] text-gray-100 font-sans overflow-hidden relative glass-environment">
                <div className="absolute top-6 left-6 z-50 flex items-center gap-3">
                    <div className="relative w-12 h-12 shrink-0 flex items-center justify-center">
                        <div className="absolute inset-0 rounded-full border-2 border-t-yellow-300 border-r-yellow-400 border-b-yellow-500 border-l-transparent animate-[spin_3s_linear_infinite] shadow-[0_0_15px_rgba(253,224,71,0.4)] opacity-90"></div>
                        <div className="w-6 h-6 rounded-sm bg-gradient-to-br from-yellow-200 via-yellow-300 to-yellow-500 flex items-center justify-center shadow-inner rotate-45">
                            <svg viewBox="0 0 24 24" className="w-4 h-4 -rotate-45 text-[#010A17]" fill="currentColor"><path d="M12 2L2 12l10 10 10-10L12 2zm0 5l5 5-5 5-5-5 5-5z"/></svg>
                        </div>
                    </div>
                    <div className="flex flex-col">
                        <span className="font-black text-2xl tracking-widest text-transparent bg-clip-text bg-gradient-to-b from-white to-white/70 leading-none">RING</span>
                        <span className="text-xs font-black text-yellow-300 tracking-[0.4em] leading-none mt-1">PAY</span>
                    </div>
                </div>

                <button onClick={exitEventMode} className="absolute top-6 right-6 z-50 glass-panel border-yellow-300/30 p-4 rounded-full text-yellow-300/50 hover:text-yellow-200 transition-colors shadow-[0_0_20px_rgba(253,224,71,0.1)]" title="Exit Receive Mode">
                    <Lock size={24} />
                </button>

                <div className="flex-1 flex flex-col md:flex-row items-center justify-center w-full max-w-6xl mx-auto p-6 gap-12 lg:gap-24 relative z-10 pt-24 md:pt-0">
                    <div className="flex flex-col items-center md:items-start gap-6 w-full md:w-auto">
                        <div className="text-center md:text-left">
                            <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-yellow-300/20 text-yellow-200 text-sm font-bold border border-yellow-300/30 mb-4 shadow-[0_0_15px_rgba(253,224,71,0.2)]">
                                <Monitor size={16} /> RECEIVE TERMINAL
                            </div>
                            <h1 className="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-2 drop-shadow-lg">{userProfile.name}</h1>
                            <div className="text-xl md:text-2xl text-yellow-300 font-mono font-bold">{userProfile.handle}</div>
                        </div>

                        <div className="glass-panel p-6 sm:p-8 rounded-[2rem] flex flex-col items-center gap-6 border-yellow-300/30 shadow-[0_0_40px_rgba(253,224,71,0.1)]">
                            <div className="w-56 h-56 sm:w-64 sm:h-64 bg-white p-3 rounded-2xl flex items-center justify-center shadow-[0_0_30px_rgba(253,224,71,0.3)] relative event-qr-container">
                                <div className="w-full h-full bg-[repeating-linear-gradient(45deg,#000,#000_15px,transparent_15px,transparent_30px),repeating-linear-gradient(-45deg,#000,#000_15px,transparent_15px,transparent_30px)] opacity-90 rounded-xl"></div>
                            </div>
                            <div className="text-center">
                                <h3 className="text-2xl font-bold text-white mb-1 tracking-wide">Scan to Send</h3>
                                <p className="text-sm text-yellow-300/80 font-mono tracking-widest uppercase">Or swipe up to beam</p>
                            </div>
                        </div>

                        <div className="glass-panel p-6 rounded-[2rem] border-yellow-300/30 text-center md:text-left w-full shadow-[0_0_30px_rgba(253,224,71,0.1)] flex justify-between items-center">
                            <div>
                                <div className="text-sm text-white/50 uppercase tracking-widest font-bold mb-1">Session Total</div>
