    function stakeToPartner(partnerId) {
      // Find a GENESIS note to stake and remove it from array
      const index = state.notes.findIndex(n => n.source === 'GENESIS');
      if (index === -1) {
        notify("Requires raw GENESIS liquidity to stake.");
        return;
      }
      
      notify("Securing asset: Filing UCC-1 Statement...");
      
      // Delay to simulate UCC Filing before re-minting
      setTimeout(() => {
        const note = state.notes.splice(index, 1)[0];
        
        // Convert to Yield-bearing asset with UCC compliance lore
        note.source = partnerId.toUpperCase();
        note.lore = `UCC-1 Lien Perfected. Secured and allocated in ${partnerId.toUpperCase()} smart contract for passive yield.`;
        note.id = partnerId.substr(0,2).toUpperCase() + '-STK-' + Math.floor(Math.random()*9000);
        note.minted = Date.now(); // Update timestamp to push to top
        
        // Re-inject and update history
        state.notes.unshift(note);
        state.history.unshift({ title: `Allocated to ${partnerId.toUpperCase()} (UCC-1)`, amount: -note.amount, date: Date.now() });
        
        save();
        playSound('success');
        notify(`Â¤${note.amount} Secured & Allocated`);
        render();
