      forgeInterval = setInterval(async () => {
        forgeProgress += 3;
        if(el) el.style.background = `conic-gradient(var(--gold) ${forgeProgress}%, transparent 0)`;
        haptic(2);
        
        if(forgeProgress >= 100) {
          clearInterval(forgeInterval);
          
          notify("Minting... Decrypting Neural Signature...");
          const id = 'RM-'+Math.floor(Math.random()*9000);
          
          const prompt = `Generate a unique, sci-fi sounding 'Origin Sector' (e.g., 'Sector 7G-Alpha', 'Orbital Node 9') and a brief 1-sentence 'Digital Signature' meaning (e.g., 'Encrypted with residual starlight.', 'Forged in the silence of the void.') for a newly minted currency note. Format: [Sector] | [Meaning]`;
          
          let lore = "Sector Unknown | Digital signature corrupted.";
          if (navigator.onLine) {
              try {
                 const raw = await callGemini(prompt);
                 if (raw) lore = raw.replace(/\|/g, " // ");
              } catch(e) { console.error(e); }
          } else {
              lore = "Local Forge | Minted offline during network partition.";
          }
          
          state.notes.unshift({ 
            id: id, 
            amount: 100, 
            source: 'GENESIS', 
            minted: Date.now(), 
            hash: '0x'+Math.random().toString(16), 
            flipped: false,
            lore: lore
          });
          
          save();
          notify("Minted Â¤100 with Neural Signature");
          playSound('success');
          setTimeout(()=>nav('wallet'), 1200);
          forgeProgress = 0;
          if(el) el.style.background = 'transparent';
        }
      }, 30);
    }
    
