    }
    .bio-scanner:active { transform: scale(0.96); }
    .bio-scanner.scanning { border-color: var(--accent); box-shadow: 0 0 40px rgba(16, 185, 129, 0.4), var(--shadow-in); }
    .bio-scanner.error { border-color: var(--danger); animation: shake 0.4s linear; }
    
    .thumb-print {
      width: 86px; height: 106px; fill: none; stroke: rgba(255,255,255,0.4); stroke-width: 2.5;
      stroke-linecap: round; transition: all 0.3s; filter: drop-shadow(0 2px 4px rgba(0,0,0,0.8));
    }
    .bio-scanner:hover .thumb-print { stroke: rgba(255,255,255,0.6); }
    .bio-scanner.scanning .thumb-print { stroke: var(--accent); opacity: 0.9; filter: drop-shadow(0 0 8px var(--accent)); }
    
    .chiral-layer {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      pointer-events: none; opacity: 0; transition: opacity 0.2s;
    }
    .scanning .chiral-layer { opacity: 1; }
    .chiral-echo {
      position: absolute; width: 86px; height: 106px; fill: none; stroke-width: 2.5;
      stroke-linecap: round; opacity: 0.7; mix-blend-mode: screen; filter: blur(1px);
    }
    .chiral-cyan { stroke: var(--chiral-cyan); transform: translateX(-5px); }
    .chiral-magenta { stroke: var(--chiral-magenta); transform: translateX(5px); }
    
    .helix-container {
      position: absolute; width: 100%; height: 100%; top: 0; left: 0;
      display: flex; justify-content: center; align-items: center; opacity: 0;
    }
    .scanning .helix-container { opacity: 1; animation: fadeIn 0.5s forwards; }
    .helix-strand {
      position: absolute; width: 150px; height: 150px; border-radius: 50%;
      border: 3px solid transparent; border-top-color: var(--chiral-cyan); border-bottom-color: var(--chiral-magenta);
      animation: spinChiral 2s linear infinite; filter: drop-shadow(0 0 5px rgba(255,255,255,0.5));
    }
    .helix-strand:nth-child(2) { width: 120px; height: 120px; animation-direction: reverse; border-left-color: var(--gold); border-right-color: transparent; }
    
    @keyframes spinChiral { to { transform: rotate(360deg); } }
    @keyframes shake { 0%, 100% {transform: translateX(0);} 25% {transform: translateX(-5px);} 75% {transform: translateX(5px);} }
    
    .scan-text {
      font-family: var(--font-mono); font-size: 11px; letter-spacing: 3px; font-weight: 700;
