    /* --- SECURITY LAYER (CHIRAL BIOMETRICS) --- */
    #security-overlay {
      position: absolute; inset: 0; background: rgba(5, 5, 8, 0.85); backdrop-filter: blur(40px); -webkit-backdrop-filter: blur(40px); z-index: 9999;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
