    function bindSwipe() {
      const container = document.getElementById('swipe-container');
      const knob = document.getElementById('swipe-knob');
      const progress = document.getElementById('swipe-progress');
      const text = document.getElementById('swipe-text');
      if(!container || !knob) return;

      let isDragging = false; let startX = 0;
      let maxDrag = container.offsetWidth - knob.offsetWidth - 12; // Adjusted for padding

      const onStart = (e) => {
        if(posInput === "0" || posInput === "0.00") return; 
        isDragging = true; startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        knob.style.transition = 'none'; progress.style.transition = 'none'; text.style.opacity = '0.3'; haptic(5);
      };

      const onMove = (e) => {
        if(!isDragging) return;
        let diff = (e.type.includes('touch') ? e.touches[0].clientX : e.clientX) - startX;
        if(diff < 0) diff = 0; if(diff > maxDrag) diff = maxDrag;
        knob.style.transform = `translateX(${diff}px)`; progress.style.width = `${diff + (knob.offsetWidth/2)}px`;
        if(diff >= maxDrag - 2) {
          isDragging = false; knob.style.transform = `translateX(${maxDrag}px)`; text.style.opacity = '0';
          processPOSCharge(); setTimeout(() => resetSwipe(), 1500);
        }
      };

      const onEnd = () => { if(isDragging) { isDragging = false; resetSwipe(); } };
      
      const resetSwipe = () => {
        knob.style.transition = 'transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)'; progress.style.transition = 'width 0.4s ease';
        knob.style.transform = `translateX(0px)`; progress.style.width = `0px`; text.style.opacity = '0.8'; text.innerText = "SWIPE TO SETTLE";
      }

      knob.addEventListener('mousedown', onStart); window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onEnd);
      knob.addEventListener('touchstart', onStart, {passive: false}); window.addEventListener('touchmove', onMove, {passive: false}); window.addEventListener('touchend', onEnd);
      swipeCleanup = () => { window.removeEventListener('mousemove', onMove); window.removeEventListener('mouseup', onEnd); window.removeEventListener('touchmove', onMove); window.removeEventListener('touchend', onEnd); }
    }

