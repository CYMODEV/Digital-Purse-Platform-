  <script>
    // --- GEMINI API INTEGRATION ---
    const apiKey = "";
    
    async function callGemini(prompt) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`;
      const payload = { contents: [{ parts: [{ text: prompt }] }] };
      const delays = [1000, 2000, 4000, 8000, 16000];
      
      for (let i = 0; i < delays.length; i++) {
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const data = await response.json();
          return data.candidates?.[0]?.content?.parts?.[0]?.text || "Data corrupted.";
        } catch (e) {
          if (i === delays.length - 1) return "Connection lost. Neural grid unavailable.";
          await new Promise(r => setTimeout(r, delays[i]));
        }
      }
    }

    // --- STATE ---
    const DB_KEY = 'cpurse_v2_enhanced';
    const DEFAULTS = {
      route: 'wallet',
      filter: 'ALL',
      notes: [
        { id: 'GEN-001', amount: 100, source: 'GENESIS', minted: Date.now(), hash: '0x7F...3A', flipped: false, lore: 'Sector 0: The Prime Origin.' },
        { id: 'PP-882', amount: 50, source: 'PAYPAL', minted: Date.now()-50000, hash: '0xPP...22', flipped: false, lore: 'Transfer packet intercepted from Old Web.' },
        { id: 'TR-105', amount: 1000, source: 'TREASURY', minted: Date.now()-100000, hash: '0xUS...T1', flipped: false, lore: 'Federal remnant. High stability.' },
        { id: 'ETH-554', amount: 10, source: 'ETHEREUM', minted: Date.now()-200000, hash: '0xET...99', flipped: false, lore: 'Gas fees crystalized into value.' },
        { id: 'CA-221', amount: 20, source: 'CASHAPP', minted: Date.now()-300000, hash: '0xCA...01', flipped: false, lore: 'Peer-to-peer echo.' }
      ],
      history: [
         { title: 'Coffee Shop', amount: -4.50, date: Date.now() - 1000000 },
         { title: 'Uber Ride', amount: -22.00, date: Date.now() - 5000000 },
         { title: 'Mint Fee', amount: -0.50, date: Date.now() - 8000000 },
         { title: 'Transfer In', amount: +500.00, date: Date.now() - 12000000 }
      ],
      connections: { paypal: false, cashapp: false, treasury: false, ethereum: false },
      compliance: { status: 'VERIFIED', riskScore: '1.4', tier: 'LEVEL 2', uccStatus: 'PERFECTED' },
      settings: { sound: true, haptics: true, faceId: true }, 
      offlineQueue: [],
      apiKeys: [],
      customPartners: []
    };
    
    let state = JSON.parse(localStorage.getItem(DB_KEY)) || DEFAULTS;
    
    // Migrations
    if (typeof state.settings.faceId === 'undefined') state.settings.faceId = true;
    if (typeof state.offlineQueue === 'undefined') state.offlineQueue = [];
    if (typeof state.compliance === 'undefined') state.compliance = DEFAULTS.compliance;
    if (typeof state.compliance.uccStatus === 'undefined') state.compliance.uccStatus = 'PERFECTED';
    if (typeof state.apiKeys === 'undefined') state.apiKeys = [];
    if (typeof state.customPartners === 'undefined') state.customPartners = [];
    
    if (state.connections && typeof state.connections.eth !== 'undefined') {
        state.connections.ethereum = state.connections.eth;
        delete state.connections.eth;
        save();
    }

    let forgeProgress = 0;
    let forgeInterval = null;
    let scanInterval = null;
    let scanProgress = 0;
    let audioCtx = null;
    let posInput = "0";
    let deferredPrompt;
    let swipeCleanup = null;
    const fixedChartDepths = [30, 45, 60, 25, 50, 80, 40, 60];

    function initPWA() {
      const manifest = {
        name: "cpurse", short_name: "cpurse", start_url: ".", display: "standalone",
        background_color: "#000000", theme_color: "#050505",
        icons: [{
          src: "data:image/svg+xml;base64,",
          sizes: "512x512", type: "image/svg+xml"
        }]
      };
      const stringManifest = JSON.stringify(manifest);
      const blobManifest = new Blob([stringManifest], {type: 'application/manifest+json'});
      document.getElementById('pwa-manifest').href = URL.createObjectURL(blobManifest);

      if ('serviceWorker' in navigator) {
        const swCode = `self.addEventListener('install', (e) => self.skipWaiting()); self.addEventListener('activate', (e) => self.clients.claim()); self.addEventListener('fetch', (e) => {});`;
        const blobSW = new Blob([swCode], {type: 'application/javascript'});
        navigator.serviceWorker.register(URL.createObjectURL(blobSW)).catch(()=>{});
      }
    }

    function checkNetworkStatus() {
      const banner = document.getElementById('offline-banner');
      if (!navigator.onLine) {
        banner.classList.add('active');
        if (state.route === 'pos') notify("Offline Mode. TXs will be queued.");
      } else {
        banner.classList.remove('active');
        syncOfflineTransactions();
      }
    }
    window.addEventListener('online', checkNetworkStatus);
    window.addEventListener('offline', checkNetworkStatus);

    async function syncOfflineTransactions() {
      if (state.offlineQueue.length === 0) return;
      notify(`Syncing ${state.offlineQueue.length} offline TXs...`);
      setTimeout(() => {
        state.offlineQueue.forEach(tx => { state.history.unshift(tx.historyEntry); state.notes.unshift(tx.noteEntry); });
        state.offlineQueue = []; save(); notify("Offline Sync Complete.");
        if(state.route === 'wallet') render();
      }, 2000);
    }

    function save() { localStorage.setItem(DB_KEY, JSON.stringify(state)); }

    function initAudio() {
      if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
    }
    
    function playSound(type) {
      if (!state.settings.sound) return;
      if (!audioCtx) initAudio();
      if (!audioCtx) return; 

      const t = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.connect(gain); gain.connect(audioCtx.destination);

      if (type === 'tap') {
        osc.type = 'sine'; osc.frequency.setValueAtTime(800, t); osc.frequency.exponentialRampToValueAtTime(100, t + 0.015);
        gain.gain.setValueAtTime(0.1, t); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.015);
        osc.start(t); osc.stop(t + 0.015);
      } else if (type === 'success') {
        osc.type='triangle'; osc.frequency.setValueAtTime(600, t); osc.frequency.linearRampToValueAtTime(1200, t+0.2);
        gain.gain.setValueAtTime(0.1, t); gain.gain.linearRampToValueAtTime(0, t+0.4);
        osc.start(t); osc.stop(t+0.4);
      } else if (type === 'scan') {
        osc.type='sawtooth'; osc.frequency.setValueAtTime(100, t); osc.frequency.linearRampToValueAtTime(400, t+1.5);
        gain.gain.setValueAtTime(0.02, t); gain.gain.linearRampToValueAtTime(0.05, t+1.5);
        osc.start(t); osc.stop(t+1.5);
      }
    }

    function haptic(pattern) { if(state.settings.haptics && navigator.vibrate) navigator.vibrate(pattern); }

    function startBioScan() {
      initAudio();
      const scanner = document.getElementById('bio-scanner');
      const status = document.getElementById('bio-status');
      scanner.classList.add('scanning'); status.innerText = "Analyzing Chirality...";
      playSound('scan'); haptic(50);
      scanProgress = 0;
      scanInterval = setInterval(() => {
        scanProgress += 2;
        if (scanProgress % 20 === 0) haptic(10);
        if (scanProgress >= 100) {
          clearInterval(scanInterval); scanner.classList.remove('scanning');
          status.innerText = "CHIRAL MATCH CONFIRMED"; status.style.color = "var(--terminal-green)";
          playSound('success');
          setTimeout(() => { document.getElementById('security-overlay').classList.add('hidden'); }, 800);
        }
      }, 30);
    }
    
    function cancelBioScan() {
      clearInterval(scanInterval);
      const scanner = document.getElementById('bio-scanner');
      const status = document.getElementById('bio-status');
      scanner.classList.remove('scanning'); status.innerText = "Hold to Scan"; status.style.color = "var(--text-muted)";
    }
    
    function relock() {
      if(!state.settings.faceId) { notify("Enable Chiral Guard first"); return; }
      document.getElementById('security-overlay').classList.remove('hidden');
      document.getElementById('bio-status').innerText = "Hold to Scan";
      document.getElementById('bio-status').style.color = "var(--text-muted)";
      playSound('tap');
    }
    
    function factoryReset() {
      if(confirm("Factory Reset: Wipe all keys, notes, and history?")) {
        localStorage.removeItem(DB_KEY); localStorage.removeItem('installDismissed'); window.location.reload();
      }
    }

    function nav(route) {
      if(swipeCleanup) swipeCleanup(); 
      state.route = route; save(); initAudio(); playSound('tap'); haptic(10);
      document.querySelectorAll('.dock-item').forEach(el => el.classList.remove('active'));
      const navItem = document.getElementById(`nav-${route}`);
      if(navItem) navItem.classList.add('active');
      const titles = { mint:'Forge', wallet:'Vault', network:'Bridge', pos:'Terminal', settings:'Settings', dev:'Dev Portal' };
      document.getElementById('page-title').innerText = titles[route] || 'cpurse';
      render();
    }
    
    function notify(msg) {
      const t = document.getElementById('toast');
      document.getElementById('toast-text').innerText = msg;
      t.classList.add('active'); setTimeout(() => t.classList.remove('active'), 2500); haptic(20);
    }

    function setFilter(f) { state.filter = f; save(); render(); playSound('tap'); }

    async function apiSettleTransaction(amount) { return new Promise(resolve => setTimeout(() => resolve({ status: 'success' }), 1200)); }

    async function processPOSCharge() {
      const amt = parseFloat(posInput); if(amt <= 0) return;
      const historyEntry = { title: 'POS Settlement', amount: amt, date: Date.now() };
      const noteEntry = { 
        id: 'POS-'+Math.floor(Math.random()*9000), amount: amt, source: 'POS_SETTLEMENT', minted: Date.now(), 
        hash: '0x'+Math.random().toString(16).substr(2, 10).toUpperCase(), flipped: false, lore: 'Settled via external terminal link.'
