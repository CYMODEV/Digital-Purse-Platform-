  Shield, Wallet, Smartphone, CreditCard, Activity, Lock, Globe, RefreshCw,
  CheckCircle, XCircle, QrCode, ArrowRightLeft, Users, Building2, DollarSign,
  Menu, History, Camera, Wifi, WifiOff, UserCheck, Scan, X, FileText,
  Banknote, Download, Fingerprint, ChevronRight, Settings, TrendingUp,
  Unlock, Layers, Network, Server
} from 'lucide-react';

// --- MOCK DATA & STATE ---
const INITIAL_SUPPLY = 12500000.00;
const INITIAL_USER_BALANCE = 2450.50;

const NETWORKS = [
