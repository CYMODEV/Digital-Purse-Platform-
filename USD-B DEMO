  const OnboardingFlow = () => (
    <div className="min-h-screen bg-slate-950 flex flex-col relative animate-in fade-in overflow-hidden">
      <div className="absolute top-0 right-0 w-[50%] h-[50%] bg-blue-600/20 rounded-full filter blur-[120px]"></div>
      <div className="flex-1 flex flex-col items-center justify-center p-8 text-center relative z-10">
        <div className="w-24 h-24 bg-white/10 backdrop-blur-xl border border-white/20 rounded-full flex items-center justify-center mb-10 shadow-2xl">
          <Fingerprint className="w-12 h-12 text-indigo-400" />
        </div>
        <h2 className="text-4xl font-black text-white mb-6">Secure Your Asset</h2>
        <p className="text-slate-400 text-lg mb-14 max-w-sm leading-relaxed">
