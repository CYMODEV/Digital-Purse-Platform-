  { id: 'sol', name: 'Solana', icon: '◎', status: 'Fastest' },
  { id: 'arb', name: 'Arbitrum', icon: 'A', status: 'Low Fee' },
  { id: 'hbar', name: 'Hedera Hashgraph', icon: 'ℏ', status: 'Enterprise' }
];

export default function USDBPlatform() {
  // App Lifecycle State
  const [appState, setAppState] = useState('landing'); // 'landing', 'splash', 'onboarding', 'main'
  const [activeRole, setActiveRole] = useState('user'); 
  const [notification, setNotification] = useState(null);

  // Blockchain/Global State
  const [totalSupply, setTotalSupply] = useState(INITIAL_SUPPLY);
  const [userBalance, setUserBalance] = useState(INITIAL_USER_BALANCE);
  const [savingsBalance, setSavingsBalance] = useState(5000.00); 
  const [merchantBalance, setMerchantBalance] = useState(5400.00);
  const [userFrozen, setUserFrozen] = useState(false);
  const [userVerified, setUserVerified] = useState(false); 
  const [isOffline, setIsOffline] = useState(false); 
  const [cardLocked, setCardLocked] = useState(false); 
  const [activeDLT, setActiveDLT] = useState(NETWORKS[0]);

  // UI State
  const [posAmount, setPosAmount] = useState('');
  const [posTip, setPosTip] = useState(0); 
  const [posStep, setPosStep] = useState('amount'); 
  const [isScanning, setIsScanning] = useState(false);
  const [showScanner, setShowScanner] = useState(false);
  const [merchantQR, setMerchantQR] = useState(null);
  const [showSwap, setShowSwap] = useState(false);
  const [showCardManager, setShowCardManager] = useState(false); 
  const [showSettings, setShowSettings] = useState(false);
  const [showNetworkSelector, setShowNetworkSelector] = useState(false);
  
  // Admin Modal States
  const [showMintModal, setShowMintModal] = useState(false);
  const [mintStep, setMintStep] = useState(0); 
  const [showRedeemModal, setShowRedeemModal] = useState(false);

  // Compliance Logs & History
  const [auditLogs, setAuditLogs] = useState([
    { id: 1, action: 'SYSTEM_INIT', detail: 'Ledger Genesis Block Verified', time: '08:00 AM', status: 'Success' },
    { id: 2, action: 'RESERVE_CHECK', detail: 'Oracle Proof of Reserve: Match', time: '09:00 AM', status: 'Success' },
  ]);

  const [txHistory, setTxHistory] = useState([
    { id: 1, type: 'Yield', entity: 'T-Bill Vault Interest', amount: +12.50, time: 'Today', status: 'Settled', role: 'user', network: 'Ethereum' },
    { id: 2, type: 'Send', entity: 'Starbucks 044', amount: -6.50, time: 'Yesterday', status: 'Settled', role: 'user', network: 'Solana' },
    { id: 3, type: 'Mint', entity: 'Chase Bank', amount: +500.00, time: 'Yesterday', status: 'Settled', role: 'user', network: 'Ethereum' },
    { id: 4, type: 'Receive', entity: 'Consumer Wallet', amount: 12.50, time: '10:42 AM', status: 'Settled', role: 'merchant', network: 'Solana' },
  ]);

  // --- LIFECYCLE HANDLERS ---
  const handleDownload = () => {
    setAppState('splash');
    setTimeout(() => {
      setAppState('onboarding');
    }, 2500);
  };

  const handleBiometricAuth = () => {
    setIsScanning(true);
    setTimeout(() => {
      setIsScanning(false);
      setAppState('main');
      showNotification("Authentication Successful", "success");
    }, 1500);
  };

  // --- HELPERS ---
  const showNotification = (msg, type = 'success') => {
    setNotification({ msg, type });
    setTimeout(() => setNotification(null), 3000);
  };

  const addAuditLog = (action, detail, status = 'Success') => {
    setAuditLogs(prev => [{
      id: Date.now(), action, detail, time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }), status
    }, ...prev]);
  };

  const executeTransaction = (amount, entityName = 'Merchant Terminal 01') => {
    if (userFrozen) {
      showNotification("TRANSACTION BLOCKED: Wallet Frozen by Regulator (Ref: OFAC-104)", "error");
      addAuditLog("TX_BLOCK", `Attempted transfer from Frozen Wallet: 0x71...9A2`, "Blocked");
      return false;
    }
    if (!userVerified && activeRole === 'user') {
      showNotification("Identity Verification Required to Transact", "error");
      return false;
    }
    if (userBalance < amount && activeRole === 'user') {
      showNotification("Insufficient Funds in Consumer Wallet", "error");
      return false;
    }

    const isLargeTx = amount >= 3000;
    
    setIsScanning(true);
    setTimeout(() => {
      setUserBalance(prev => prev - amount);
      setMerchantBalance(prev => prev + amount);
      
      const timeNow = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const newTxId = Date.now();
      
      const userTx = { 
        id: newTxId, type: 'Send', entity: entityName, amount: -amount, time: timeNow, 
        status: isOffline ? 'Pending (Offline Proof)' : 'Settled', role: 'user', network: activeDLT.name
      };
      const merchantTx = {
        id: newTxId + 1, type: 'Receive', entity: 'Consumer Wallet 0x71...9A2', amount: amount, time: timeNow, 
        status: isOffline ? 'Pending Settlement' : 'Settled', role: 'merchant', network: activeDLT.name
      };

      setTxHistory(prev => [userTx, merchantTx, ...prev]);
      if (isLargeTx) addAuditLog("TRAVEL_RULE", `Large Tx ($${amount}) - PII Attached (Encrypted)`, "Logged");

      setIsScanning(false);
      setPosAmount('');
      setPosTip(0);
      setPosStep('amount');
      setMerchantQR(null);
      setShowScanner(false);
      showNotification(`Processed $${amount.toFixed(2)} on ${activeDLT.name}`);
    }, 1500);
    return true;
  };

