             <button onClick={() => setIsOffline(!isOffline)} className="p-2.5 bg-white/10 hover:bg-white/20 rounded-full backdrop-blur-xl border border-white/20 transition-all text-white">
                 {isOffline ? <WifiOff className="w-4 h-4 text-amber-400" /> : <Wifi className="w-4 h-4" />}
             </button>
          </div>
        </div>
        
        <div className="text-center mb-10">
          <div className="text-slate-400 text-sm mb-2 font-medium tracking-wide uppercase">Spending Balance</div>
          <div className="text-[4rem] leading-none font-black tracking-tighter text-white drop-shadow-2xl">
            ${userBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
          </div>
        </div>

        <div className="flex justify-center gap-4">
          <button className="flex-1 py-4 bg-white/10 backdrop-blur-2xl rounded-[1.5rem] flex flex-col items-center justify-center gap-2 border border-white/20 hover:bg-white/20 transition-all shadow-xl">
