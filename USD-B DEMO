      {notification && (
        <div className={`fixed top-8 right-8 z-[100] px-8 py-5 rounded-2xl shadow-2xl text-white font-bold flex items-center gap-4 animate-in fade-in slide-in-from-top-4 backdrop-blur-xl border ${
          notification.type === 'error' ? 'bg-red-900/80 border-red-500/50' : notification.type === 'info' ? 'bg-indigo-900/80 border-indigo-500/50' : 'bg-emerald-900/80 border-emerald-500/50'
        }`}>
          {notification.type === 'error' ? <XCircle className="w-6 h-6" /> : <CheckCircle className="w-6 h-6" />}
          <div className="uppercase tracking-widest text-sm">{notification.msg}</div>
