          <button onClick={() => { setActiveRole('merchant'); setAppState('main'); }} className="w-full sm:w-auto bg-white/10 backdrop-blur-xl border border-white/20 text-white px-8 py-4 rounded-2xl font-bold text-lg hover:bg-white/20 transition-all flex items-center justify-center gap-3 hover:scale-105 active:scale-95">
