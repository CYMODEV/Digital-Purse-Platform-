          <button onClick={() => setShowNetworkSelector(true)} className="flex items-center gap-2 bg-white/10 px-4 py-2 rounded-full backdrop-blur-xl border border-white/20 hover:bg-white/20 transition-all shadow-lg">
            <div className={`w-2 h-2 rounded-full ${isOffline ? 'bg-amber-400' : 'bg-emerald-400'} animate-pulse`}></div>
